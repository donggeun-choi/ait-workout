# Public ad group identifier, not an API key. Production ads stay off if empty.
# Development always uses the official test ID; never use a live ID for testing.
VITE_TOSS_BANNER_AD_GROUP_ID=

# Full HTTPS API base, e.g. https://community.example.com/api/community.
# Empty uses /api/community on the same origin.
VITE_COMMUNITY_API_URL=
# Explicit browser test authentication; ignored in production builds.
VITE_COMMUNITY_DEV_AUTH=false
