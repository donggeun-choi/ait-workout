# Node 24; load environment through deployment secrets / node --env-file.
COMMUNITY_HOST=127.0.0.1
COMMUNITY_PORT=5194
COMMUNITY_DB_PATH=data/community.sqlite
COMMUNITY_DEV_AUTH=false
COMMUNITY_PUBLIC_ENABLED=false
COMMUNITY_ALLOWED_ORIGINS=https://YOUR-APP-ORIGIN
# Paths to private files, never browser VITE_ variables.
TOSS_MTLS_CERT_PATH=
TOSS_MTLS_KEY_PATH=
COMMUNITY_ADMIN_ORIGIN=https://YOUR-SERVER-ORIGIN
COMMUNITY_ADMIN_TOKEN=
# Exact base64 value after 'Basic ' registered in Toss console.
TOSS_CALLBACK_BASIC_AUTH=
COMMUNITY_POLICY_URL=
COMMUNITY_OPERATOR_CONTACT=
COMMUNITY_RETENTION_DAYS=30
